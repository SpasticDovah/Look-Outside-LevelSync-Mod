// LevelSync configuration. Lines starting with // are ignored.
// Changes take effect the next time the game is launched.
//
// levelOffset:
//   0 = companions catch up to Sam's exact level and EXP
//   1 = companions catch up to Sam's level - 1, with the same % progress 
//       toward the next level as Sam (default)
//   2 = Sam's level - 2 with Sam's % progress, etc.
//
// excludedActorIds: actors that are never synced. The defaults are the
// in-game video game heroes (29-37) and non-companion actors (27, 40, 41).
// showLevelUpMessage is off by default because it could potentially pop up in the middle of other dialogue.
{
    "enabled": true,
    "levelOffset": 1,
    "sourceActorId": 1,
    "excludedActorIds": [27, 29, 30, 31, 32, 33, 34, 35, 36, 37, 40, 41],
    "preserveHpMpRatio": true,
    "showLevelUpMessage": false
}
